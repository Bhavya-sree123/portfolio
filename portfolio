<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Segoe UI',sans-serif;
  scroll-behavior:smooth;
}

body{
  background:#f5f7fa;
  color:#333;
}

/* NAVBAR */
nav{
  background:#111827;
  padding:15px 40px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:1000;
}

nav h2{
  color:white;
}

nav ul{
  list-style:none;
  display:flex;
  flex-wrap:wrap;
}

nav ul li{
  margin-left:20px;
}

nav ul li a{
  color:white;
  text-decoration:none;
  font-size:14px;
  cursor:pointer;
  transition:0.3s;
}

nav ul li a:hover{
  color:#38bdf8;
}

/* HERO */
.hero{
  height:80vh;
  background:linear-gradient(to right,#2563eb,#06b6d4);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  color:white;
  padding:20px;
}

.hero h1{
  font-size:40px;
  margin-bottom:10px;
}

.hero p{
  font-size:18px;
  max-width:700px;
}

/* SECTIONS */
.section{
  padding:60px 10%;
}

.section h2{
  text-align:center;
  margin-bottom:40px;
}

/* PROJECTS GRID */
.projects{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.card{
  background:white;
  padding:20px;
  border-radius:10px;
  box-shadow:0 5px 15px rgba(0,0,0,0.1);
  transition:0.3s;
}

.card:hover{
  transform:translateY(-5px);
}

/* BUTTONS */
.btn{
  display:inline-block;
  margin-top:10px;
  padding:8px 15px;
  background:#2563eb;
  color:white;
  text-decoration:none;
  border-radius:5px;
  font-size:14px;
  transition:0.3s;
}

.btn:hover{
  background:#1d4ed8;
}

/* SKILLS */
.skills span{
  display:inline-block;
  background:#2563eb;
  color:white;
  padding:7px 14px;
  border-radius:20px;
  margin:5px;
  font-size:13px;
}

/* CERTIFICATES */
.certs{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:15px;
}

.certs div{
  background:white;
  padding:15px;
  border-radius:8px;
  box-shadow:0 3px 10px rgba(0,0,0,0.1);
  width:220px;
  text-align:center;
}
/* ACHIEVEMENTS */
.achievements ul{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:15px;}

/* FOOTER */
footer{
  text-align:center;
  padding:20px;
  background:#111827;
  color:white;
  margin-top:40px;
}

/* RESPONSIVE */
@media(max-width:768px){
  nav{
    flex-direction:column;
  }
  nav ul{
    margin-top:10px;
    flex-direction:column;
    align-items:center;
  }
  nav ul li{
    margin:6px 0;
  }
  .hero h1{
    font-size:28px;
  }
}
</style>
</head>

